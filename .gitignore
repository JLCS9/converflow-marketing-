# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo
# Compiled output must never sit next to sources: NodeNext imports use .js
# extensions, so a stale src/index.js can shadow src/index.ts at runtime.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map

# Env files (never commit secrets)
.env
.env.*
!.env*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Test
coverage/
.nyc_output/

# Prisma
packages/db/prisma/migrations/dev.db
packages/db/src/generated/

# Baileys sessions (never commit, contain WhatsApp creds)
**/baileys-auth/
**/auth_info_*/

# Local infra
infra/docker/data/
infra/docker/.volumes/

# Misc
*.pem
*.key
.python-version

# Local-only scratch (fixtures for manual verification, never committed).
# Must live inside a workspace package or tsx can't resolve @converflow/*.
**/*.local.ts
