// =====================================================================
// converflow.ai — Prisma schema
//
// Multitenant pool model. Tenant-scoped tables enforce isolation via
// Postgres Row Level Security. The API sets `app.tenant_id` per request
// in a transaction-scoped session variable (see packages/db/src/rls.ts).
//
// Platform-level tables (PlatformAdmin*, AppVersion) have no tenant_id
// and are accessed only through admin context.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [pgcrypto, vector]
}

// ============================================
// PLATFORM (no tenant scope, no RLS)
// ============================================

model PlatformAdmin {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String
  totpSecret         String?
  totpEnabled        Boolean     @default(false)
  status             AdminStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  mustChangePassword Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sessions PlatformAdminSession[]
  actions  AdminActionLog[]

  @@map("platform_admins")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model PlatformAdminSession {
  id        String        @id @default(cuid())
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String        @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_admin_sessions")
}

model AdminActionLog {
  id         String        @id @default(cuid())
  adminId    String
  admin      PlatformAdmin @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime      @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_action_log")
}

model AppVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  releasedAt  DateTime
  title       String
  description String
  highlights  Json?
  createdAt   DateTime @default(now())

  @@index([releasedAt])
  @@map("app_versions")
}

// ============================================
// TENANT-SCOPED (RLS enforced)
// ============================================

model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  status TenantStatus @default(TRIAL)

  // Limits controlled by super admin
  maxUsers                 Int @default(20)
  maxBots                  Int @default(1)
  maxConversationsPerMonth Int @default(5000)
  maxStorageGb             Int @default(5)

  /// --- Controles de automatización e IA (el tenant manda, no nosotros) ---
  /// Análisis automático de cada mensaje entrante (clasificación + sugerencia).
  /// Es el mayor consumidor de tokens del producto: se dispara en CADA mensaje.
  aiInboundAnalysis Boolean @default(true)
  /// Tope duro de tokens de IA por mes natural. NULL = sin tope. Al superarlo
  /// las funciones de IA se paran en seco en lugar de seguir gastando.
  aiMonthlyTokenCap Int?
  /// Configuración del motor de alertas: por regla, activada y umbrales.
  /// NULL = todas activas con los valores por defecto (comportamiento previo).
  alertRules        Json?

  // Kit Digital tracking
  kitDigitalSegment     String?
  kitDigitalActivatedAt DateTime?

  // Metadata
  contactEmail String
  contactPhone String?
  timezone     String  @default("Europe/Madrid")
  locale       String  @default("es-ES")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  suspendedAt DateTime?

  users                    User[]
  invitations              TenantInvitation[]
  apiKeys                  ApiKey[]
  bots                     Bot[]
  agents                   Agent[]
  accessLogs               AccessLog[]
  clients                  Client[]
  leads                    Lead[]
  opportunities            Opportunity[]
  tasks                    Task[]
  documents                Document[]
  notes                    Note[]
  alerts                   Alert[]
  aiUsage                  AiUsage[]
  calendarConnections      CalendarConnection[]
  conversations            Conversation[]
  messages                 Message[]
  emailConnections         EmailConnection[]
  customFieldDefinitions   CustomFieldDefinition[]
  pipelines                Pipeline[]
  leadScoreBatches         LeadScoreBatch[]
  campaigns                Campaign[]
  campaignRecipients       CampaignRecipient[]
  suppressions             Suppression[]
  emailTemplates           EmailTemplate[]
  mailConnections          MailConnection[]
  emailThreads             EmailThread[]
  emailMessages            EmailMessage[]
  emailAttachments         EmailAttachment[]
  emailThreadNotes         EmailThreadNote[]
  emailMessageTranslations EmailMessageTranslation[]
  emailThreadReads         EmailThreadRead[]
  profiles                 Profile[]
  profileIdentities        ProfileIdentity[]
  events                   Event[]
  ragCollections           RagCollection[]
  ragChunks                RagChunk[]
  lifecycleDefinitions     LifecycleDefinition[]
  lifecycleStates          LifecycleState[]
  consents                 Consent[]

  @@map("tenants")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model User {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String     @unique
  name               String
  passwordHash       String
  role               UserRole   @default(AGENT_USER)
  status             UserStatus @default(ACTIVE)
  // Optional per-user permission override. When null, the user inherits the
  // role's defaults from @converflow/shared/permissions. When set, it is the
  // explicit list of allowed PermissionModule values. OWNER ignores this
  // field at runtime — they always have full access.
  permissions        Json?
  // Per-user home dashboard layout: { widgets: string[] } — the ordered list of
  // enabled widget ids. Null = use the default layout from the client registry.
  dashboardConfig    Json?
  /// Idioma de la interfaz para ESTE usuario (ISO-639-1: es | en | fr).
  /// NULL = hereda el del tenant. Es por usuario y no por cuenta a propósito:
  /// un equipo mixto tiene que poder trabajar cada uno en su idioma.
  locale             String?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions           UserSession[]
  calendarConnection CalendarConnection?
  assignedTasks      Task[]
  sentEmails         EmailMessage[]      @relation("EmailMessageSender")

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  BUILDER
  AGENT_USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model UserSession {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model TenantInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole  @default(AGENT_USER)
  token      String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([token])
  @@map("tenant_invitations")
}

/// Long-lived bearer token for the public REST API.
/// `prefix` is the visible "cfai_XXXXX" portion shown in the UI and used to
/// look up the row before doing a constant-time hash compare against
/// `keyHash` (sha256 of the full secret). The plaintext is shown to the
/// admin once at creation and never stored.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String    @unique
  keyHash    String
  /// Array of PermissionModule strings (same enum used for users).
  scopes     Json
  createdBy  String
  expiresAt  DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([prefix])
  @@map("api_keys")
}

// Kit Digital requirement: per-user access logs, stored in DB,
// exportable to CSV/JSON with date + user + email.
model AccessLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  action    String
  resource  String?
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([email])
  @@map("access_logs")
}

// Bot reply behaviour per channel — moved here from Agent so a single
// conversational agent can be SUGGEST on WhatsApp and AUTO on WebChat.
enum BotReplyMode {
  OFF
  SUGGEST
  AUTO
}

model Bot {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  channel     Channel
  phoneNumber String?
  status      BotStatus @default(PENDING)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id])

  // How the bot should reply to inbound messages. Moved from Agent so the
  // same conversational agent can be wired AUTO on a low-stakes channel
  // (web chat) and SUGGEST on a high-stakes one (WhatsApp).
  replyMode BotReplyMode @default(SUGGEST)

  // Rate limits (overridable per bot, otherwise tenant default)
  maxMessagesPerMinute Int       @default(60)
  maxMessagesPerHour   Int       @default(1500)
  warmupUntil          DateTime?

  lastConnectedAt      DateTime?
  lastDisconnectAt     DateTime?
  lastDisconnectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session         BotSession?
  conversations   Conversation[]
  emailConnection EmailConnection?
  campaigns       Campaign[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("bots")
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  WEBCHAT
  EMAIL
}

enum BotStatus {
  PENDING
  AWAITING_QR
  CONNECTING
  CONNECTED
  DISCONNECTED
  BANNED
  ERROR
}

model BotSession {
  botId              String   @id
  tenantId           String
  bot                Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  authStateEncrypted Bytes
  encryptionVersion  Int      @default(1)
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@map("bot_sessions")
}

model Agent {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  systemPrompt String
  model        String      @default("claude-sonnet-4-6")
  config       Json
  status       AgentStatus @default(DRAFT)
  // Runtime engine. See enum AgentType below.
  type         AgentType   @default(CONVERSATIONAL)
  // Wizard template the agent was created from (e.g. "agenda",
  // "oportunidades", "soporte"). Used for analytics + prefilling the same
  // form again on edit. Not part of the runtime contract.
  template     String?
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bots         Bot[]
  scoreBatches LeadScoreBatch[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("agents")
}

enum AgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// The wizard shows 12 funnel "purposes" but they collapse into three
// runtime engines. The chosen wizard tile is persisted in Agent.template
// (free string) alongside this enum.
//   CONVERSATIONAL → talks to people in a channel
//   OPPORTUNITIES  → batch-processes leads, scores them, opens opps
//   UTILITY        → headless data work (enrich, cleanup, report, summarize)
enum AgentType {
  CONVERSATIONAL
  OPPORTUNITIES
  UTILITY
}

/// Batch of bulk lead-scoring jobs. The API enqueues one row of N jobs and
/// updates `completed`/`failed` as the worker progresses; the frontend polls
/// for ETA + summary.
model LeadScoreBatch {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status        LeadScoreBatchStatus @default(QUEUED)
  total         Int
  completed     Int                  @default(0)
  failed        Int                  @default(0)
  statusUpdated Int                  @default(0)
  oppsCreated   Int                  @default(0)
  options       Json // { updateStatus, createOpportunities }
  errors        Json                 @default("[]")
  startedAt     DateTime?
  finishedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@map("lead_score_batches")
}

enum LeadScoreBatchStatus {
  QUEUED
  RUNNING
  DONE
  CANCELLED
  FAILED
}

// ============================================
// CRM (tenant-scoped, RLS enforced)
// ============================================

model Client {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  lastName     String?
  email        String?
  phone        String?
  source       String?
  status       ClientStatus @default(ACTIVE)
  ownerId      String?
  customFields Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  leads         Lead[]
  opportunities Opportunity[]
  tasks         Task[]
  documents     Document[]
  notes         Note[]

  @@index([tenantId])
  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// F1 · Perfil unificado del plano de datos (se rellena al resolver identidad).
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  name         String
  lastName     String?
  email        String?
  phone        String?
  company      String?
  source       String?
  status       LeadStatus @default(LEAD)
  score        Int?
  ownerId      String?
  customFields Json?

  // AI-generated context (Sprint 3 lead scoring)
  aiScoreReasoning String?
  aiScoreActions   Json?
  aiScoredAt       DateTime?

  contactedAt DateTime?
  qualifiedAt DateTime?
  convertedAt DateTime? // stamped once when the lead first becomes CLIENT (Sprint 10 metrics)

  opportunities Opportunity[]
  tasks         Task[]
  notes         Note[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, score])
  @@map("leads")
}

// Status flow simplified to three values:
//   LEAD   -> sigue siendo un lead (cualquier estado previo a "ganado")
//   CLIENT -> ya es cliente (antes "CONVERTED")
//   LOST   -> oportunidad perdida
// Old values (NEW, CONTACTED, QUALIFIED, CONVERTED) stay in the enum for the
// duration of one deploy so the seed can migrate them in place; they're not
// exposed in the UI and a follow-up sprint will drop them once every tenant
// is on the new triplet.
enum LeadStatus {
  LEAD
  CLIENT
  LOST
  NEW       @map("NEW")
  CONTACTED @map("CONTACTED")
  QUALIFIED @map("QUALIFIED")
  CONVERTED @map("CONVERTED")
}

model Opportunity {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name              String
  amount            Decimal?  @db.Decimal(12, 2)
  currency          String    @default("EUR")
  status            OppStatus @default(OPEN)
  probability       Int       @default(50)
  expectedCloseDate DateTime?
  closedAt          DateTime?

  ownerId      String?
  proposalUrl  String?
  customFields Json?

  pipelineId String?
  pipeline   Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId    String?
  stage      PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  tasks        Task[]
  documents    Document[]
  notes        Note[]
  stageHistory OpportunityStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, pipelineId, stageId])
  @@map("opportunities")
}

// ============================================
// Per-tenant customization
// CustomFieldDefinition: tenant-defined attributes for Lead/Client/Opportunity.
// Values live in the entity's `customFields` Json column keyed by `key`.
// Pipeline + PipelineStage: tenant-defined opportunity boards.
// ============================================

model CustomFieldDefinition {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType    CustomFieldEntity
  key           String // stable slug used as Json property name
  label         String
  type          CustomFieldType
  required      Boolean           @default(false)
  options       Json? // SELECT/MULTISELECT options: [{value,label}]
  helpText      String?
  order         Int               @default(0)
  /// F1 · Dato sensible: afecta a retención/borrado y exige consentimiento.
  sensitive     Boolean           @default(false)
  /// F1 · Días de retención del VALOR tras la baja del perfil.
  retentionDays Int?
  /// F1 · Extraíble por el motor conversacional (el esquema del LLM se
  /// genera desde las definiciones marcadas).
  extractable   Boolean           @default(false)
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

enum CustomFieldEntity {
  LEAD
  CLIENT
  OPPORTUNITY
  PROFILE
}

enum CustomFieldType {
  TEXT
  LONGTEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
  URL
  EMAIL
  PHONE
  DOCUMENT
}

model Pipeline {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  entityType PipelineEntity @default(OPPORTUNITY)
  isDefault  Boolean        @default(false)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId, entityType])
  @@map("pipelines")
}

enum PipelineEntity {
  OPPORTUNITY
}

model PipelineStage {
  id         String   @id @default(cuid())
  tenantId   String
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  key        String // stable slug, scoped to pipeline
  label      String
  color      String   @default("#3B82F6")
  order      Int      @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  opportunities Opportunity[]
  history       OpportunityStageHistory[]

  @@unique([pipelineId, key])
  @@index([tenantId, pipelineId])
  @@map("pipeline_stages")
}

model OpportunityStageHistory {
  id            String        @id @default(cuid())
  tenantId      String
  opportunityId String
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  movedAt       DateTime      @default(now())
  movedBy       String?

  @@index([opportunityId, movedAt])
  @@index([tenantId, movedAt])
  @@map("opportunity_stage_history")
}

enum OppStatus {
  OPEN
  QUOTED
  NEGOTIATING
  WON
  LOST
}

model Task {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        TaskType
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueAt       DateTime?
  completedAt DateTime?

  // For tasks auto-generated by the AI agent / workflow engine
  source    String  @default("manual")
  /// Id del recurso que originó la tarea (p. ej. el hilo de correo en las
  /// tareas de asignación de bandeja). Junto a `source` forma la clave de
  /// idempotencia: reasignar ACTUALIZA la tarea existente, no crea otra.
  /// String suelto a propósito: no acopla Task al módulo que la creó.
  sourceRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, source, sourceRef])
  @@map("tasks")
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  SUPPORT
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Document {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  name       String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([clientId])
  @@index([opportunityId])
  @@map("documents")
}

model Note {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  body     String
  authorId String

  // AI classification (Sprint 3.2 — Journeys de venta)
  aiCategory       NoteCategory?
  aiSentiment      NoteSentiment?
  aiConfidence     Float?
  aiSuggestedReply String?
  aiAnalyzedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, aiCategory])
  @@map("notes")
}

enum NoteCategory {
  BUY_INTENT
  OBJECTION
  INFO_REQUEST
  COMPLAINT
  SCHEDULING
  OFF_TOPIC
  OTHER
}

enum NoteSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

model Alert {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type        AlertType
  severity    AlertSeverity @default(INFO)
  title       String
  description String?

  resourceType String
  resourceId   String

  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
  @@map("alerts")
}

enum AlertType {
  LEAD_STALE
  OPPORTUNITY_DUE
  TASK_OVERDUE
  HIGH_SCORE_LEAD
  CLIENT_INACTIVITY
  B2B_DOMAIN
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================
// AI usage tracking (cost + audit)
// ============================================

model AiUsage {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature      String // 'lead_scoring', 'classify_message', 'chat_assistant', etc.
  model        String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  costUsd      Float?
  durationMs   Int?
  status       AiUsageStatus @default(OK)
  errorMessage String?
  resourceType String? // 'lead', 'opportunity', 'note', etc.
  resourceId   String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, feature])
  @@map("ai_usage")
}

enum AiUsageStatus {
  OK
  ERROR
}

// ============================================
// Calendar integration (Sprint 5 — IA Reuniones)
// One Google account connection per user (tenant-scoped via RLS).
// Tokens are stored encrypted (aes-256-gcm) — see common/utils/crypto.ts.
// ============================================
model CalendarConnection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    String @default("google")
  googleEmail String

  refreshTokenEnc      String // encrypted refresh token
  accessTokenEnc       String? // encrypted, short-lived
  accessTokenExpiresAt DateTime?
  scope                String?
  calendarId           String    @default("primary")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("calendar_connections")
}

// ============================================
// Conversations inbox (Sprint 8 — Chats)
// One conversation per (tenant, channel, contact). Messages are the transcript
// (IN = received, OUT = sent — incl. replies the user sends from their own
// WhatsApp, captured via Baileys fromMe). Classification lives on inbound msgs.
// ============================================
model Conversation {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botId    String?
  bot      Bot?    @relation(fields: [botId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId  String? // optional override: agent for this conversation (e.g. set by a campaign)

  channel      Channel @default(WHATSAPP)
  contactJid   String // stable contact id per channel (WA lid/pn, email address, webchat session)
  contactName  String?
  contactPhone String? // resolved real phone (+prefix) when available
  emailSubject String? // original subject (EMAIL channel) for reply threading

  status             ConversationStatus @default(PENDING)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  unreadCount        Int                @default(0)
  assignedUserId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([tenantId, channel, contactJid])
  @@index([tenantId, status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction   MessageDirection
  waMessageId String?
  body        String? // plain-text version (previews, AI, non-email channels)
  bodyHtml    String? // rich HTML body for EMAIL (sanitized); rendered when present
  mediaType   String? // null = text; 'image'|'video'|'document'|… otherwise

  // AI classification (inbound only)
  aiCategory       NoteCategory?
  aiSentiment      NoteSentiment?
  aiConfidence     Float?
  aiSuggestedReply String?
  aiAnalyzedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId, waMessageId])
  @@map("messages")
}

enum ConversationStatus {
  PENDING // last message inbound, awaiting reply
  ANSWERED // replied
  CLOSED // manually archived
}

enum MessageDirection {
  IN
  OUT
}

// ============================================
// Email channel connection (tenant connects their own mailbox via IMAP/SMTP).
// One per EMAIL bot. Credentials stored encrypted (aes-256-gcm).
// ============================================
model EmailConnection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botId    String @unique
  bot      Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  email       String
  imapHost    String
  imapPort    Int     @default(993)
  smtpHost    String
  smtpPort    Int     @default(465)
  username    String
  passwordEnc String // encrypted IMAP/SMTP password
  secure      Boolean @default(true)

  status      String  @default("CONNECTED") // CONNECTED | ERROR
  lastError   String?
  lastSeenUid Int? // IMAP INBOX incremental cursor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("email_connections")
}

// ============================================
// Campaigns (bulk outbound to groups of contacts)
// One channel per campaign (EMAIL now; WHATSAPP + others as bots connect).
// Audience = filtered leads/clients + manual include/exclude. Sending runs in
// the API (background loop, per-channel rate limit); a scheduler launches due
// SCHEDULED campaigns. Suppression list enforces opt-out / GDPR.
// ============================================
model Campaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  channel Channel @default(EMAIL)
  botId   String? // the connected bot/channel used to send
  bot     Bot?    @relation(fields: [botId], references: [id], onDelete: SetNull)

  subject String? // EMAIL only
  body    String // template with {nombre} {empresa} {email} placeholders
  agentId String? // optional: agent that handles REPLIES from this campaign's recipients

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime? // null = send immediately on launch

  // Audience snapshot: { entity, statuses[], sources[], ownerId, includeIds[], excludeIds[] }
  audience Json?

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  createdByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId   String?
  clientId String?
  name     String?
  address  String // email or phone (the channel-native destination)

  status    CampaignRecipientStatus @default(PENDING)
  error     String?
  messageId String?
  sentAt    DateTime?
  openedAt  DateTime? // first open (EMAIL tracking pixel)
  openCount Int                     @default(0)

  createdAt DateTime @default(now())

  @@unique([campaignId, address])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model Suppression {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel
  address  String // email or phone
  reason   String  @default("UNSUBSCRIBE") // UNSUBSCRIBE | MANUAL | BOUNCE

  createdAt DateTime @default(now())

  @@unique([tenantId, channel, address])
  @@index([tenantId, channel])
  @@map("suppressions")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================
// Email templates (reusable HTML, for the composer + campaigns)
// Body is sanitized HTML with {nombre}/{first_name}/{email}/{telefono} placeholders.
// ============================================
model EmailTemplate {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  subject         String?
  bodyHtml        String // compiled, responsive HTML (sent)
  mjml            String? // MJML source from the visual builder (re-edit)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("email_templates")
}

// ============================================
// MAIL MODULE (new — independent of Bots) · Fase 1: connections
// A tenant connects their OWN mailbox (BYO). Drivers abstract the transport:
// smtp_imap now; oauth_google/microsoft + provider_api later. Credentials/tokens
// are AES-256-GCM encrypted (secretEnc). Visibility: shared (team) or private
// (only ownerUserId). Tenant isolation via RLS (see rls-policies.sql).
// ============================================
model MailConnection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  driver      MailDriver @default(SMTP_IMAP)
  fromAddress String // the email address this mailbox sends/receives as
  displayName String?
  signature   String? // HTML signature (used from Fase 2)

  // smtp_imap fields (OAuth drivers reuse secretEnc for the refresh token)
  imapHost  String?
  imapPort  Int?    @default(993)
  smtpHost  String?
  smtpPort  Int?    @default(465)
  username  String?
  secretEnc String? // encrypted: SMTP/IMAP password OR OAuth refresh token

  /// Implicit TLS on connect, PER TRANSPORT. They differ in the real world:
  /// Outlook/365 is SMTP 587 (STARTTLS, false) + IMAP 993 (implicit TLS, true).
  /// A single flag for both made every Outlook mailbox unconnectable.
  /// NULL = not configured explicitly → derived from the port (see resolveSecure).
  smtpSecure Boolean?
  imapSecure Boolean?
  /// @deprecated Legacy single flag, kept only as the last-resort fallback for
  /// rows created before the split (and for non-standard ports). Do not write it.
  secure     Boolean  @default(true)

  visibility  MailVisibility @default(SHARED)
  ownerUserId String? // required when visibility = PRIVATE

  status       MailConnStatus @default(PENDING)
  lastError    String?
  lastSyncedAt DateTime?
  syncCursor   Int? // IMAP UID cursor (Fase 2)

  /// Sync health. A single transient IMAP error used to set status=ERROR, and
  /// the scheduler only ever selected CONNECTED — so one network blip killed
  /// the mailbox silently and forever. These drive the retry/backoff instead.
  consecutiveFailures Int       @default(0)
  nextRetryAt         DateTime? // NULL = eligible now
  errorNotifiedAt     DateTime? // so the owner is emailed once, not every tick

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  threads EmailThread[]

  @@unique([tenantId, fromAddress])
  @@index([tenantId])
  @@index([tenantId, visibility])
  @@map("mail_connections")
}

enum MailDriver {
  SMTP_IMAP
  OAUTH_GOOGLE
  OAUTH_MICROSOFT
  PROVIDER_API
}

enum MailVisibility {
  SHARED
  PRIVATE
}

enum MailConnStatus {
  PENDING
  CONNECTED
  /// Transient trouble (network blip, provider hiccup). STILL synced, with
  /// exponential backoff. Only escalates to ERROR after repeated failures.
  DEGRADED
  /// Needs a human: bad credentials, or too many consecutive failures. NOT
  /// picked up by the scheduler until someone fixes and re-tests the mailbox.
  ERROR
}

// ============================================
// MAIL MODULE · Fase 2.1 — inbox model (threads/messages/attachments)
// Email lives in its OWN models (decoupled from IM Conversation/Message).
// Threading: dedupe by rfcMessageId; link by In-Reply-To/References → fallback
// to normalized subject + participants within the same connection.
// ============================================
model EmailThread {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   MailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  subject        String?
  participants   Json? // string[] of addresses seen in the thread
  folder         MailFolder       @default(INBOX) // thread bucket: INBOX|ARCHIVE|SPAM|TRASH
  status         MailThreadStatus @default(OPEN) // for shared mailboxes
  assigneeUserId String?
  labels         Json? // string[] custom labels
  unreadCount    Int              @default(0)
  lastMessageAt  DateTime?
  snippet        String?

  /// Cached AI summary. Recomputed only when the thread has grown since it was
  /// made (aiSummaryMsgCount != current non-draft count). NOT optional: the
  /// thread detail is re-fetched every 12s by the inbox poller, so summarizing
  /// on read would pay for a Claude call on every tick.
  aiSummary         Json?
  aiSummaryAt       DateTime?
  aiSummaryMsgCount Int?

  // Soft lock for anti-collision in shared mailboxes: who is replying and when
  // (heartbeat-refreshed; considered stale after a short timeout).
  lockedByUserId String?
  lockedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages EmailMessage[]
  notes    EmailThreadNote[]
  reads    EmailThreadRead[]

  @@index([tenantId, connectionId, folder, lastMessageAt])
  @@index([tenantId, assigneeUserId])
  @@map("email_threads")
}

/// Per-user read state for SHARED mailboxes.
///
/// The global `EmailThread.unreadCount` stays for private mailboxes and the
/// existing badges, but in a 15-person shared inbox "read" cannot be global:
/// one person opening a thread must not mark it read for everyone else.
///
/// Rule: unread-for-me = row exists ? lastMessageAt > lastReadAt
///                                  : fall back to the global unreadCount.
/// Assigning a thread upserts the ASSIGNEE's row with lastReadAt = epoch, so
/// it shows as unread for them regardless of the global state.
model EmailThreadRead {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId   String
  thread     EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime

  @@unique([threadId, userId])
  @@index([tenantId, userId])
  @@map("email_thread_reads")
}

/// Internal note on an email thread (team-only, never sent to the contact).
model EmailThreadNote {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId     String
  thread       EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  authorName   String // denormalized for display
  body         String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("email_thread_notes")
}

model EmailMessage {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId     String
  thread       EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  connectionId String

  rfcMessageId String? // RFC Message-ID (dedupe key per connection)
  /// Cabecera Reply-To del original: si existe, responder debe ir AQUÍ y no al
  /// From (RFC 5322 §3.6.2). Nullable y aditiva; el histórico queda a NULL y
  /// para él se usa From, que es el comportamiento previo.
  replyTo      String?
  inReplyTo    String?
  references   String? // space-separated RFC references

  direction MailDirection
  isDraft   Boolean       @default(false)
  folder    MailFolder    @default(INBOX)

  fromAddress  String?
  fromName     String?
  /// Which team member sent this (OUT messages only). Without it a shared
  /// mailbox can only ever say "Tú" — you cannot tell whether María or Juan
  /// replied. NULL for inbound mail and for anything sent before this existed.
  sentByUserId String?
  sentBy       User?     @relation("EmailMessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  toAddresses  Json? // string[]
  ccAddresses  Json?
  bccAddresses Json?
  subject      String?
  html         String?
  text         String?
  snippet      String?
  spamScore    Float?
  /// ISO-639-1 of the body, detected once and cached. Drives whether the
  /// "Traducir" button is even shown — offering it on a message already in the
  /// reader's language is noise.
  detectedLang String?
  readAt       DateTime?
  sentAt       DateTime?
  receivedAt   DateTime?

  createdAt DateTime @default(now())

  attachments  EmailAttachment[]
  translations EmailMessageTranslation[]

  @@unique([connectionId, rfcMessageId])
  @@index([threadId, createdAt])
  @@index([tenantId, connectionId, folder])
  @@index([sentByUserId])
  @@map("email_messages")
}

/// Cached translation of one message into one language.
///
/// Cached because the same message gets opened many times and the inbox poller
/// re-reads the thread every 12s. Only the PLAIN TEXT is translated, never the
/// HTML: it is far cheaper, and it avoids re-introducing unsanitized markup into
/// a module whose safety rests on sanitizing at ingest.
model EmailMessageTranslation {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  lang      String // ISO-639-1 target
  text      String
  model     String? // which model produced it, for cost/quality audits
  createdAt DateTime     @default(now())

  @@unique([messageId, lang])
  @@index([tenantId, createdAt])
  @@map("email_message_translations")
}

model EmailAttachment {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String // R2 object key
  inline     Boolean @default(false)
  contentId  String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("email_attachments")
}

enum MailFolder {
  INBOX
  SENT
  DRAFTS
  SPAM
  ARCHIVE
  TRASH
}

enum MailThreadStatus {
  OPEN
  PENDING
  CLOSED
}

enum MailDirection {
  IN
  OUT
}

// ============================================================================
// Motor de IA — F0 · Plano de datos y memoria por tenant
//
// Reglas duras (cambiarlas exige discusión explícita):
//  - Toda tabla nueva nace con política RLS `tenant_isolation` (el test
//    estático rls-coverage.spec.ts lo exige).
//  - RagChunk.content JAMÁS contiene datos personales: el contexto del caso
//    va en `meta` (filtrable); el texto se generaliza. Así el borrado RGPD de
//    un perfil nunca tiene que tocar la memoria vectorial.
//  - Precio y stock no se vectorizan: viven en el catálogo y se consultan en
//    vivo al responder.
// ============================================================================

/// Perfil unificado del contacto. El CRM actual (Lead) apunta aquí vía
/// Lead.profileId cuando el plano de datos resuelve la identidad (F1).
model Profile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String?
  lastName String?
  company  String?
  locale   String?
  /// Campos del vertical (validados contra CustomFieldDefinition, F1).
  custom   Json?

  /// Estado de ciclo de vida VIGENTE (denormalizado; histórico en
  /// lifecycle_states). NULL = aún sin evaluar.
  lifecycleState String?

  identities       ProfileIdentity[]
  events           Event[]
  lifecycleHistory LifecycleState[]
  consents         Consent[]
  leads            Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, updatedAt])
  @@index([tenantId, lifecycleState])
  @@map("profiles")
}

/// email/teléfono/wa_id → perfil. Matching determinista: email manda,
/// teléfono es secundario. `value` va normalizado (email en minúsculas,
/// teléfono E.164) — la normalización vive en el módulo identity.
model ProfileIdentity {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  kind   IdentityKind
  value  String
  /// Adaptador que la aportó ('brevo', 'learndash', 'crm', 'mail', 'api').
  source String?

  createdAt DateTime @default(now())

  @@unique([tenantId, kind, value])
  @@index([profileId])
  @@map("profile_identities")
}

enum IdentityKind {
  EMAIL
  PHONE
  WA_ID
  EXTERNAL
}

/// Evento normalizado del plano de datos. `type` es un enum abierto
/// ('purchase', 'enrollment', 'email_open'…): el consumidor tolera tipos
/// desconocidos, igual que el timeline del lead (lead-timeline.ts).
/// Sin particionar a propósito: volumen de piloto; particionar es una
/// decisión futura con datos en la mano.
model Event {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  type       String
  source     String
  occurredAt DateTime
  props      Json?
  /// Id en el sistema origen, para dedupe de webhooks reentregados.
  externalId String?

  createdAt DateTime @default(now())

  @@unique([tenantId, source, externalId])
  @@index([tenantId, profileId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@map("events")
}

/// Colección RAG por tenant ('knowledge' | 'verified' | 'catalog').
/// El modelo de embeddings y su dimensión se fijan POR COLECCIÓN: migrar de
/// modelo = crear colección nueva y re-vectorizar, nunca migrar schema.
model RagCollection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key            String
  name           String
  embeddingModel String
  dim            Int

  chunks RagChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("rag_collections")
}

/// Fragmento vectorizado. La columna es `vector` sin dimensión fija hasta que
/// el benchmark de F0 cierre modelo/dimensión; entonces apply:ddl la tipa y
/// crea el índice HNSW (ver packages/db/prisma/sql/ddl.sql). Las consultas
/// van SIEMPRE por $queryRaw dentro de withTenant — fuera de esa transacción
/// el RLS no filtra.
model RagChunk {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collectionId String
  collection   RagCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  /// REGLA DURA: sin datos personales. El contexto va en `meta`.
  content   String
  embedding Unsupported("vector")?
  /// Metadatos filtrables: segmento, producto, fuente, vigencia.
  meta      Json?
  /// Referencia al origen (catalog_item, documento…) para re-vectorización.
  sourceRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, collectionId])
  @@map("rag_chunks")
}

/// Máquina de estados del ciclo de vida, declarada por tenant (F1).
model LifecycleDefinition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  /// [{ key, label }] — el primer estado es el inicial.
  states      Json
  /// Reglas declarativas (ver lifecycle.engine.ts):
  /// [{ from: string|null, to: string, when: {...} }]
  transitions Json
  active      Boolean @default(true)
  /// Plantilla de vertical de origen ('elearning', 'residencias'…).
  template    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("lifecycle_definitions")
}

/// Histórico de transiciones (append-only); el vigente está en Profile.
model LifecycleState {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  state    String
  previous String?
  /// Qué disparó la transición ('event:purchase', 'rule:inactivity-90d'…).
  reason   String?

  createdAt DateTime @default(now())

  @@index([tenantId, profileId, createdAt])
  @@map("lifecycle_states")
}

/// Consentimiento por perfil, canal y finalidad, con evidencia (F1).
model Consent {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  channel  String
  purpose  String
  granted  Boolean
  /// { at, where, textShown, ip? } — la evidencia que exige el RGPD.
  evidence Json

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tenantId, profileId, channel, purpose])
  @@map("consents")
}
